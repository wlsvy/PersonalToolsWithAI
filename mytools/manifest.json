{
  "manifest_version": 3,
  "name": "PersonalToolsWithAI",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "clipboardRead",
    "clipboardWrite",
    "contextMenus",
    "offscreen",
    "storage",
    "nativeMessaging",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "summary-panel": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "요약·번역 (사이드 패널)"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PersonalToolsWithAI"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "features/text-expander/snippets.js",
        "features/text-expander/expander.js"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
